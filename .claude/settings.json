{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(node --version)",
      "Bash(npm --version)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./.dev.vars)",
      "Read(./**/.dev.vars)",
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(wrangler:*)",
      "Bash(npx wrangler:*)",
      "Bash(npm publish:*)"
    ]
  }
}
